{
  "extraKnownMarketplaces": {
    "ipremium": {
      "source": { "source": "github", "repo": "cristianosousaa-dev/ipremium-claude-kit" }
    }
  },
  "enabledPlugins": {
    "ipremium-kit@ipremium": true,
    "ipremium-web@ipremium": true,
    "ipremium-data@ipremium": true,
    "ipremium-integrations@ipremium": false,
    "ipremium-automation@ipremium": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npx supabase *)",
      "Bash(vercel *)"
    ]
  }
}
